# XCall deployment environment.
# Copy to .env and edit.

# --- portal ---
DB_PASSWORD=change-me-postgres
FUSIONPBX_ADMIN_USER=admin
FUSIONPBX_ADMIN_PASSWORD=change-me-admin

# --- AI agent ---
# ESL password must match freeswitch/conf/autoload_configs/event_socket.conf.xml
ESL_PASSWORD=ClueCon

# conversation engine: script | assistant
AGENT_MODE=assistant

# assistant-mode source. In Docker, the portal service is reachable as http://portal.
# PORTAL_SECRET must equal v_xcall_settings.agent_shared_secret from the portal DB.
PORTAL_URL=http://portal/ai-assistant/assistant_api.php
PORTAL_SECRET=

# AI engines: stub (no ML deps) | whisper | vosk ; piper | espeak ; ollama | none
STT_ENGINE=stub
TTS_ENGINE=stub
LLM_ENGINE=none

# --- TLS ---
# Domain name for the portal / WSS endpoint. For a public server set this and
# configure ACME; for a LAN box the nginx config ships a self-signed default.
X_DOMAIN=xcall.local
