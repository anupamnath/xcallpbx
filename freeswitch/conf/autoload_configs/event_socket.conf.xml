<?xml version="1.0" encoding="utf-8"?>
<!--
    XCall — FreeSWITCH Event Socket (ESL) configuration.

    The AI agent connects here (default 8021). Keep this reachable only from
    the hosts that run the agent / XCall services — the password must match
    the `esl.password` value in ai-agent/config.yaml.
-->
<configuration name="event_socket.conf" description="Socket Client">
    <settings>
        <param name="nat-map" value="false"/>
        <param name="listen-ip" value="0.0.0.0"/>
        <param name="listen-port" value="8021"/>
        <param name="password" value="ClueCon"/>
        <param name="apply-inbound-acl" value="loopback.auto"/>
        <!-- Allow the XCall services subnet to talk to ESL. Add your host here
             (CIDR) if the agent runs on a different machine:
             <param name="apply-inbound-acl" value="xcall.auto"/> -->
    </settings>
</configuration>
