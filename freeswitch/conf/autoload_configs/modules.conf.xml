<?xml version="1.0" encoding="utf-8"?>
<!--
    XCall — FreeSWITCH module load list (overlay).

    Ensures the modules the XCall system needs are present:
    - mod_sofia       : SIP endpoints (internal profile)
    - mod_verto       : WebRTC endpoint for the web softphone
    - mod_event_socket: ESL for the AI agent
    - mod_dptools     : answer/park/playback/record apps used by the dialplan
    - mod_local_stream: music-on-hold streams
    - mod_shell_stream: optional audio streaming helper (for advanced TTS)
    - mod_spandsp / mod_sndfile: media formats
-->
<configuration name="modules.conf" description="Modules">
    <modules>

        <load module="mod_console"/>
        <load module="mod_logfile"/>

        <!-- core apps -->
        <load module="mod_dptools"/>
        <load module="mod_commands"/>
        <load module="mod_curl"/>
        <load module="mod_db"/>
        <load module="mod_hash"/>
        <load module="mod_lcr"/>
        <load module="mod_limit"/>
        <load module="mod_redis"/>
        <load module="mod_distributor"/>

        <!-- codecs / formats -->
        <load module="mod_g723_1"/>
        <load module="mod_g729"/>
        <load module="mod_g722"/>
        <load module="mod_opus"/>
        <load module="mod_ilbc"/>
        <load module="mod_speex"/>
        <load module="mod_sndfile"/>
        <load module="mod_spandsp"/>
        <load module="mod_local_stream"/>
        <load module="mod_tone_stream"/>
        <load module="mod_shell_stream"/>
        <load module="mod_av"/>
        <load module="mod_avmd"/>

        <!-- SIP / WebRTC endpoints -->
        <load module="mod_sofia"/>
        <load module="mod_verto"/>
        <load module="mod_loopback"/>

        <!-- ESL (AI agent control) -->
        <load module="mod_event_socket"/>

        <!-- presence / dialplan -->
        <load module="mod_dialplan_xml"/>
        <load module="mod_dialplan_asterisk"/>
        <load module="mod_callcenter"/>
        <load module="mod_conference"/>
        <load module="mod_fifo"/>
        <load module="mod_valet_parking"/>

        <!-- logging / CDR -->
        <load module="mod_cdr_csv"/>
        <load module="mod_xml_cdr"/>

        <!-- lua (optional, for custom dialplan scripts) -->
        <load module="mod_lua"/>

    </modules>
</configuration>
